<!DOCTYPE html>
<html lang="en">
  <%= _head(conn: @conn, title: "Settings") %>
  <body>
    <%= _header(conn: @conn, active: :settings) %>

    <main class="fwf-page fwf-page--narrow">
      <div class="fwf-page-head">
        <h1>Settings</h1>
      </div>

      <div class="fwf-stack">
        <%= if Map.get(assigns, :success_message) do %>
          <div class="fwf-banner fwf-banner--success" role="status">
            <p><%= html_escape(@success_message) %></p>
            <a href="<%= path(@conn, "/settings") %>" class="fwf-banner-close" aria-label="Dismiss"><%= icon(@conn, "cancel") %></a>
          </div>
        <% end %>

        <%= if Map.get(assigns, :error_message) do %>
          <div class="fwf-banner fwf-banner--danger" role="alert">
            <p><%= html_escape(@error_message) %></p>
          </div>
        <% end %>

        <section class="fwf-card fwf-settings-section" aria-labelledby="fwf-h-theme">
          <h2 id="fwf-h-theme">Theme</h2>
          <p>Saved in this browser. "System" follows your OS.</p>
          <div class="fwf-seg" role="radiogroup" aria-label="Color scheme" id="fwf-theme-choice">
            <label><input type="radio" name="fwf-theme" value="system" checked><%= icon(@conn, "computer") %>System</label>
            <label><input type="radio" name="fwf-theme" value="light"><%= icon(@conn, "sun") %>Light</label>
            <label><input type="radio" name="fwf-theme" value="dark"><%= icon(@conn, "moon") %>Dark</label>
          </div>
        </section>

        <section class="fwf-card fwf-settings-section" aria-labelledby="fwf-h-export">
          <h2 id="fwf-h-export">Export flags</h2>
          <p>Download every flag and its gates as one file (Erlang Term Format, <code>.etf</code>). It can be imported later to restore them.</p>
          <form action="<%= path(@conn, "/settings/export") %>" method="post">
            <input type="hidden" name="_csrf_token" value="<%= @conn.assigns[:csrf_token] %>">
            <button type="submit" class="fwf-btn">Export all flags</button>
          </form>
        </section>

        <section class="fwf-card fwf-settings-section" aria-labelledby="fwf-h-import">
          <h2 id="fwf-h-import">Import flags</h2>
          <%= if @import_disabled do %>
            <%!-- The rule is APP_ENV != "dev" (Router.import_disabled?/0): one
                line, no form that can't be used. --%>
            <p class="fwf-import-off">Import is only available in development.</p>
          <% else %>
            <p>Restore flags from an export file (<code>.etf</code>, up to 10 MB and 10,000 flags).</p>

            <div class="fwf-stack">
              <%= if Map.get(assigns, :import_error_message) do %>
                <div class="fwf-banner fwf-banner--danger" role="alert">
                  <p><strong>Import failed:</strong> <%= html_escape(@import_error_message) %></p>
                </div>
              <% end %>

              <form action="<%= path(@conn, "/settings/import") %>" method="post" enctype="multipart/form-data" class="fwf-stack">
                <input type="hidden" name="_csrf_token" value="<%= @conn.assigns[:csrf_token] %>">

                <div class="fwf-field">
                  <label class="fwf-label" for="file">File</label>
                  <input type="file" class="fwf-file" id="file" name="file" accept=".etf" required>
                </div>

                <fieldset class="fwf-field fwf-fieldset">
                  <legend class="fwf-label">Mode</legend>
                  <label class="fwf-radio-card" for="mode-overwrite">
                    <input type="radio" name="mode" value="overwrite" id="mode-overwrite" checked>
                    <span><strong>Import and overwrite</strong><small>Flags in the file replace flags with the same name. Other flags are left alone.</small></span>
                  </label>
                  <label class="fwf-radio-card" for="mode-clear">
                    <input type="radio" name="mode" value="clear" id="mode-clear">
                    <span><strong>Clear and import</strong> <span class="fwf-danger-text">(destructive)</span><small>Deletes every existing flag first, then imports the file.</small></span>
                  </label>
                </fieldset>

                <div>
                  <button type="submit" class="fwf-btn fwf-btn--primary">Import flags</button>
                </div>
              </form>
            </div>
          <% end %>
        </section>

        <details class="fwf-card fwf-settings-section fwf-about">
          <summary>About import and export</summary>
          <h3>Use cases</h3>
          <ul>
            <li><strong>Backup:</strong> regular exports for disaster recovery</li>
            <li><strong>Migration:</strong> move flags between environments</li>
            <li><strong>Versioning:</strong> keep flag configurations from specific points in time</li>
          </ul>
          <h3>Safety</h3>
          <ul>
            <li>Imports are atomic (all or nothing)</li>
            <li>Files are validated before anything is written</li>
            <li>Size and count limits prevent resource exhaustion</li>
            <li>Imports and exports are recorded in the audit log</li>
          </ul>
          <h3>File format</h3>
          <p>Erlang Term Format (<code>.etf</code>), a binary format native to Elixir/Erlang.</p>
        </details>
      </div>
    </main>
  </body>
</html>
