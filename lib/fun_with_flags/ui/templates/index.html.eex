<!DOCTYPE html>
<html lang="en">
  <%= _head(conn: @conn, title: "List") %>
  <body>
    <nav id="fwf-top-bar" class="navbar navbar-inverse navbar-toggleable-xl">
      <a class="navbar-brand" href="https://github.com/tompave/fun_with_flags">FunWithFlags</a>
      <div class="collapse navbar-collapse">
        <ul class="navbar-nav mr-auto">
          <li class="nav-item active">
            <a class="nav-link" href="">all flags</a>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="<%= path(@conn, "/audit_logs") %>">audit logs</a>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="<%= path(@conn, "/settings") %>">settings</a>
          </li>
        </ul>

        <a href="<%= path(@conn, "/new") %>" class="btn btn-secondary">New Flag</a>
      </div>
    </nav>

    <div class="container mt-3">
      <div class="row d-none d-md-flex">
        <div class="col">
          <table class="table table-hover">
            <thead class="thead-default">
              <tr>
                <th class="fwf-sortable" data-sort-asc="name_asc" data-sort-desc="name_desc" style="cursor: pointer; user-select: none;">
                  name <%= if @sort == "name_asc" do %>&uarr;<% end %><%= if @sort == "name_desc" do %>&darr;<% end %>
                </th>
                <th class="fwf-sortable" data-sort-asc="status_asc" data-sort-desc="status_desc" style="cursor: pointer; user-select: none;">
                  status <%= if @sort == "status_asc" do %>&uarr;<% end %><%= if @sort == "status_desc" do %>&darr;<% end %>
                </th>
                <th>gates</th>
                <th class="fwf-sortable" data-sort-asc="created_asc" data-sort-desc="created_desc" style="cursor: pointer; user-select: none;">
                  created <%= if @sort == "created_asc" do %>&uarr;<% end %><%= if @sort == "created_desc" do %>&darr;<% end %>
                </th>
              </tr>
            </thead>
            <tbody>
              <%= for flag <- @flags do %>
                <tr>
                  <td>
                    <a href="<%= path(@conn, "/flags/#{url_safe(flag.name)}") %>">
                      <%= html_escape(flag.name) %>
                    </a>
                  </td>

                  <td>
                    <%= html_smart_status_for(flag) %>
                  </td>

                  <td>
                    <%= html_gate_list(flag) %>
                  </td>

                  <td>
                    <%= if flag.created_at, do: format_utc_timestamp(flag.created_at), else: "-" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <div class="container d-flex flex-column d-md-none">
      <%= for flag <- @flags do %>
        <div class="card mb-3">
          <div class="card-body">
            <h5 class="card-title">
              <a href="<%= path(@conn, "/flags/#{url_safe(flag.name)}") %>">
                <%= html_escape(flag.name) %>
              </a>
            </h5>
            <div class="d-flex flex-column gap-2">
              <div>
                <strong>Status:</strong>
                <%= html_smart_status_for(flag) %>
              </div>
              <div>
                <strong>Gates:</strong>
                <%= html_gate_list(flag) %>
              </div>
              <div>
                <strong>Created:</strong>
                <%= if flag.created_at, do: format_utc_timestamp(flag.created_at), else: "-" %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    <script>
      (function() {
        var sort = '<%= @sort %>';
        var stored = localStorage.getItem('fwf-sort');

        if (stored && stored !== sort && !new URLSearchParams(window.location.search).has('sort')) {
          var url = new URL(window.location);
          url.searchParams.set('sort', stored);
          window.location = url.toString();
          return;
        }

        if (sort !== 'status') {
          localStorage.setItem('fwf-sort', sort);
        }

        document.querySelectorAll('.fwf-sortable').forEach(function(th) {
          th.addEventListener('click', function() {
            var ascKey = this.dataset.sortAsc;
            var descKey = this.dataset.sortDesc;
            var next = (sort === ascKey) ? descKey : ascKey;
            localStorage.setItem('fwf-sort', next);
            var url = new URL(window.location);
            url.searchParams.set('sort', next);
            window.location = url.toString();
          });
        });
      })();
    </script>
  </body>
</html>
