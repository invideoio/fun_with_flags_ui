<!DOCTYPE html>
<html lang="en">
  <%= _head(conn: @conn, title: page_title(assigns)) %>
  <body class="fwf-flags-page<%= if @selected_name, do: " fwf-has-selection" %>"
        data-base="<%= path(@conn, "/flags") %>"
        data-viewer="<%= html_escape(@viewer || "") %>"<%= if @selected_name do %>
        data-selected="<%= html_escape(@selected_name) %>"<% end %>>
    <%= _header(conn: @conn, active: :flags) %>

    <main class="fwf-app">
      <%= if assigns[:deleted_name] do %>
        <div class="fwf-banner fwf-banner--info fwf-flash" id="fwf-flash" role="status">
          <p>Deleted <strong class="fwf-mono"><%= html_escape(@deleted_name) %></strong>.</p>
          <button type="button" class="fwf-banner-close fwf-js-only" id="fwf-flash-close" aria-label="Dismiss"><%= icon(@conn, "cancel") %></button>
        </div>
      <% end %>
      <div class="fwf-toolbar" id="fwf-toolbar">
        <div class="fwf-search-row">
          <div class="fwf-search-box fwf-js-only">
            <%= icon(@conn, "search") %>
            <input type="search" id="fwf-search" class="fwf-input fwf-search"
                   placeholder="Search flags, actor IDs, groups"
                   aria-label="Search flags by name, actor ID or group"
                   aria-keyshortcuts="/"
                   autocomplete="off" spellcheck="false">
            <span class="fwf-search-hint" aria-hidden="true"><kbd>/</kbd></span>
          </div>
          <button type="button" class="fwf-btn fwf-filters-toggle" id="fwf-filters-toggle" aria-expanded="false" aria-controls="fwf-filters">
            <%= icon(@conn, "filter") %>Filters<span class="fwf-chip-count" id="fwf-filters-count" hidden>0</span>
          </button>
          <a href="<%= path(@conn, "/new") %>" class="fwf-btn fwf-btn--primary fwf-new-flag" aria-keyshortcuts="n" aria-label="New flag"><%= icon(@conn, "add") %><span class="fwf-new-flag-label">New flag</span><kbd class="fwf-btn-kbd" aria-hidden="true">n</kbd></a>
        </div>

        <div class="fwf-filters fwf-js-only" id="fwf-filters">
          <div class="fwf-seg" role="group" aria-label="Status">
            <button type="button" data-status="" aria-pressed="true">All</button>
            <button type="button" data-status="on" aria-pressed="false">On</button>
            <button type="button" data-status="partial" aria-pressed="false">Partial</button>
            <button type="button" data-status="off" aria-pressed="false">Off</button>
          </div>

          <div class="fwf-filter-group" role="group" aria-label="Gate type">
            <span class="fwf-filter-label" aria-hidden="true">Gates</span>
            <button type="button" class="fwf-chip" data-type="boolean" aria-pressed="false">boolean</button>
            <button type="button" class="fwf-chip" data-type="actor" aria-pressed="false">actor</button>
            <button type="button" class="fwf-chip" data-type="group" aria-pressed="false">group</button>
            <button type="button" class="fwf-chip" data-type="percentage" aria-pressed="false">%</button>
          </div>

          <span class="fwf-filter-sep" aria-hidden="true"></span>

          <div class="fwf-filter-group" role="group" aria-label="Quick filters">
            <button type="button" class="fwf-chip" data-chip="pinned" aria-pressed="false"><%= icon(@conn, "star") %>Pinned</button>
            <%= if @any_created do %>
              <button type="button" class="fwf-chip" data-chip="new" aria-pressed="false" title="Created in the last 14 days">New</button>
            <% end %>
            <%= if @viewer do %>
              <button type="button" class="fwf-chip" data-chip="mine" aria-pressed="false" title="Flags with an actor gate for <%= html_escape(@viewer) %>">Mine</button>
            <% end %>
          </div>

          <div class="fwf-filter-end">
            <span class="fwf-active-filters" id="fwf-active-filters" hidden>
              <button type="button" class="fwf-btn fwf-btn--quiet fwf-btn--sm" id="fwf-clear-filters"><%= icon(@conn, "cancel") %><span>Clear filters</span></button>
            </span>
            <div class="fwf-sort">
              <label for="fwf-sort-key" class="fwf-filter-label">Sort</label>
              <select id="fwf-sort-key" class="fwf-select fwf-select--sm">
                <option value="name">name</option>
                <option value="created">created</option>
                <option value="status">status</option>
              </select>
              <button type="button" class="fwf-sort-dir" id="fwf-sort-dir" data-dir="asc" aria-label="Sort direction: ascending"><%= icon(@conn, "arrow-up") %></button>
            </div>
            <span class="fwf-count" id="fwf-count" aria-live="polite"><%= length(@flags) %> flags</span>
          </div>
        </div>
      </div>

      <div class="fwf-split">
        <section class="fwf-list-col" id="fwf-list-col" aria-label="Flags">
          <ul class="fwf-list" id="fwf-list">
            <%= for flag <- @flags do %><%= _flag_list_item(conn: @conn, flag: flag, selected: to_string(flag.name) == @selected_name) %><% end %>
            <%= if longest = longest_flag_name(@flags) do %><li class="fwf-row-sizer" aria-hidden="true"><span class="fwf-row-name"><%= html_escape(longest) %></span><span class="fwf-pill fwf-pill-partial">Partial</span></li><% end %>
          </ul>
          <div class="fwf-list-empty" id="fwf-list-empty"<%= unless @flags == [], do: " hidden" %>>
            <%= if @flags == [] do %>
              <p>There are no flags yet.</p>
              <a href="<%= path(@conn, "/new") %>" class="fwf-btn fwf-btn--primary">Create the first flag</a>
            <% else %>
              <p id="fwf-list-empty-text">No flags match.</p>
              <button type="button" class="fwf-btn" id="fwf-list-empty-clear">Clear search and filters</button>
            <% end %>
          </div>
        </section>

        <section class="fwf-panel-col" id="fwf-panel" aria-label="Flag details">
          <%= if @flag do %>
            <%= _flag_panel(assigns) %>
          <% else %>
            <%= if @selected_name do %>
              <%= _flag_panel_not_found(conn: @conn, name: @selected_name) %>
            <% else %>
              <%= _flag_panel_empty(conn: @conn) %>
            <% end %>
          <% end %>
        </section>
      </div>
    </main>

    <template id="fwf-panel-empty-template"><%= _flag_panel_empty(conn: @conn) %></template>

    <script type="text/javascript" src="<%= path(@conn, "/assets/flags_core.js") %>" defer></script>
    <script type="text/javascript" src="<%= path(@conn, "/assets/flags.js") %>" defer></script>
  </body>
</html>
