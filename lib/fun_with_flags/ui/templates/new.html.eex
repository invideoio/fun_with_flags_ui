<!DOCTYPE html>
<html lang="en">
  <%= _head(conn: @conn, title: "New Flag") %>
  <body>
    <%= _header(conn: @conn, active: :new) %>

    <main class="fwf-page fwf-page--narrow">
      <div class="fwf-page-head">
        <h1>New flag</h1>
        <a href="<%= path(@conn, "/flags") %>" class="fwf-page-sub fwf-icon-link"><%= icon(@conn, "arrow-left") %>All flags</a>
      </div>

      <form id="new-flag-form" action="<%= path(@conn, "/flags") %>" method="post" class="fwf-card fwf-settings-section fwf-stack">
        <input type="hidden" name="_csrf_token" value="<%= @conn.assigns[:csrf_token] %>">

        <div class="fwf-field">
          <label class="fwf-label" for="new-flag-name-field">Flag name</label>
          <input type="text" class="fwf-input fwf-input--mono" id="new-flag-name-field" name="flag_name"
                 placeholder="e.g. new_checkout_flow" autocomplete="off" spellcheck="false" autofocus
                 aria-describedby="new-flag-name-help"<%= if assigns[:error_message], do: ~s{ aria-invalid="true"} %>>
          <%= if assigns[:error_message] do %>
            <p class="fwf-error" role="alert"><%= @error_message %></p>
          <% end %>
          <small id="new-flag-name-help" class="fwf-hint">
            Letters, numbers and underscores only. Lowercase snake_case is the idiomatic choice. New flags start off.
          </small>
        </div>

        <div>
          <button type="submit" class="fwf-btn fwf-btn--primary">Create flag</button>
          <a href="<%= path(@conn, "/flags") %>" class="fwf-btn fwf-btn--quiet">Cancel</a>
        </div>
      </form>
    </main>
  </body>
</html>
