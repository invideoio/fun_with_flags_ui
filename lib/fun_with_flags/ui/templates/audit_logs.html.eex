<!DOCTYPE html>
<html lang="en">
  <%= _head(conn: @conn, title: "Audit Logs") %>
  <body>
    <%= _header(conn: @conn, active: :audit) %>

    <main class="fwf-page">
      <div class="fwf-page-head">
        <h1>Audit log</h1>
        <%= if assigns[:audit_total] do %>
          <span class="fwf-page-sub"><%= @audit_total %> entries</span>
        <% end %>
      </div>

      <%= if assigns[:audit_disabled] do %>
        <div class="fwf-banner fwf-banner--warning" role="alert">
          <p>Audit logging is not enabled. Configure <code>:audit_logs</code> in your <code>fun_with_flags</code> config to enable it.</p>
        </div>
      <% else %>
        <form class="fwf-search-form" method="get" action="<%= path(@conn, "/audit_logs") %>" role="search">
          <label class="fwf-sr" for="fwf-audit-search">Flag name</label>
          <input type="search" id="fwf-audit-search" class="fwf-input fwf-input--mono" name="flag_name" data-page-search aria-keyshortcuts="/"
                 placeholder="Filter by flag name"
                 value="<%= html_escape(assigns[:search_flag_name] || "") %>">
          <button class="fwf-btn" type="submit">Search</button>
          <%= if assigns[:search_flag_name] && assigns[:search_flag_name] != "" do %>
            <a href="<%= path(@conn, "/audit_logs") %>" class="fwf-btn fwf-btn--quiet">Clear</a>
          <% end %>
        </form>

        <%= _audit_log_table(assigns) %>
        <%= _audit_log_pagination(assigns) %>
      <% end %>
    </main>
    <script type="text/javascript" src="<%= path(@conn, "/assets/audit_logs.js") %>"></script>
  </body>
</html>
