<% records = assigns[:audit_records] || [] %>
<% show_flag = !assigns[:hide_flag_column] %>

<%= if Enum.empty?(records) do %>
  <p class="fwf-muted">No audit log entries found.</p>
<% else %>
  <div class="fwf-card fwf-table-wrap">
    <table class="fwf-table fwf-audit-table">
      <thead>
        <tr>
          <th>Time</th>
          <%= if show_flag do %>
            <th>Flag</th>
          <% end %>
          <th>Action</th>
          <th>User</th>
        </tr>
      </thead>
      <tbody>
        <%= for record <- records do %>
          <tr>
            <td>
              <time class="fwf-utc-timestamp" data-utc="<%= format_utc_timestamp(record.inserted_at) %>" title="<%= format_utc_timestamp(record.inserted_at) %> UTC">
                <%= format_utc_timestamp(record.inserted_at) %> UTC
              </time>
            </td>
            <%= if show_flag do %>
              <td>
                <%= if record.flag_name do %>
                  <a href="<%= path(@conn, "/flags/#{url_safe(record.flag_name)}") %>"><code><%= html_escape(record.flag_name) %></code></a>
                <% else %>
                  <span class="fwf-muted">(bulk operation)</span>
                <% end %>
              </td>
            <% end %>
            <td><%= describe_audit_record(record) %></td>
            <td>
              <%= if record.user_id do %>
                <%= html_escape(record.user_id) %>
              <% else %>
                <span class="fwf-muted">—</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
