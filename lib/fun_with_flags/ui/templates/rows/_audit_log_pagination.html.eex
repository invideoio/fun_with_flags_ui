<% page = assigns[:audit_page] || 1 %>
<% total_pages = assigns[:audit_total_pages] || 1 %>
<% total = assigns[:audit_total] || 0 %>

<%= if total_pages > 1 do %>
  <nav class="fwf-pager pagination" aria-label="Audit log pagination">
    <%= if page > 1 do %>
      <a class="fwf-btn fwf-btn--sm page-link" href="<%= audit_log_page_path(@conn, page - 1, assigns) %>"><%= icon(@conn, "arrow-left") %>Newer</a>
    <% end %>
    <%= if page < total_pages do %>
      <a class="fwf-btn fwf-btn--sm page-link" href="<%= audit_log_page_path(@conn, page + 1, assigns) %>">Older<%= icon(@conn, "arrow-right") %></a>
    <% end %>
    <span class="fwf-pager-info fwf-pager-gap">Page <%= page %> of <%= total_pages %> · <%= total %> entries</span>
  </nav>
<% end %>
